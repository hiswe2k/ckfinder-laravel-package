{
    "name": "hiswe2k/ckfinder-laravel-package",
    "description": "CKFinder 3 package for Laravel",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1.0",
        "laravel/framework": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "pimple/pimple": "~3.0",
        "ext-json": "*",
        "ext-gd": "*",
        "ext-zip": "*"
    },
    "autoload": {
        "psr-4": {
            "CKSource\\CKFinderBridge\\": "src/",
            "CKSource\\CKFinder\\": "_connector/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CKSource\\CKFinderBridge\\CKFinderServiceProvider"
            ]
        }
    }
}
